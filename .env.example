ADMIN_EMAIL=admin@vfiveeducation.com
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-to-a-long-random-secret-in-production
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (local install or hosted — e.g. Supabase, Neon)
# Match pgAdmin login (usually postgres + your password)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/vfive

# Cloudinary — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=vfive
